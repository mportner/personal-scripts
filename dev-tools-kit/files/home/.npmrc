# Mirrors the host's ~/.npmrc. pnpm is the package manager here; npm exists only
# because it ships inside the Node tarball, and this makes sure that if anything
# does reach for it, it is subject to the same rules.
#
# npm counts min-release-age in DAYS (its own hint is <days>, and it flattens to
# `before` as Date.now() - 86400000 * age). pnpm counts minimumReleaseAge in
# MINUTES. So the 5 here and the 7200 in .config/pnpm/config.yaml are the same
# five-day window, not a disagreement.
# The sandbox's registry pin and strict TLS are not here either, for the same
# reason as the pnpm side: a project's own .npmrc outranks this one, so
# NPM_CONFIG_REGISTRY and NPM_CONFIG_STRICT_SSL in spec.yaml are what a stray
# in-tree config cannot override.
min-release-age=5
ignore-scripts=true
